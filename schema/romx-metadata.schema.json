{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romx.example/schema/romx-metadata-0.1.0.json",
  "title": "ROMX Metadata 0.1.0",
  "type": "object",
  "required": ["schema_version", "name", "platform", "payload_format", "crc32"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "platform": {
      "enum": ["gb", "gbc", "gba", "nes", "snes", "nds", "3ds", "genesis"]
    },
    "payload_format": {
      "enum": ["gb", "gbc", "gba", "nes", "fds", "sfc", "smc", "nds", "3ds", "cci", "md", "gen", "smd"]
    },
    "serial": { "type": "string", "maxLength": 128 },
    "developer": { "type": "string", "maxLength": 256 },
    "publisher": { "type": "string", "maxLength": 256 },
    "origin": { "type": "string", "maxLength": 128 },
    "franchise": { "type": "string", "maxLength": 256 },
    "release_date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "genre": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 64 },
      "uniqueItems": true
    },
    "region": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 32 },
      "uniqueItems": true
    },
    "language": { "type": "string", "maxLength": 256 },
    "users": { "type": "integer", "minimum": 1, "maximum": 255 },
    "coop": { "type": "boolean" },
    "rumble": { "type": "boolean" },
    "analog": { "type": "boolean" },
    "enhancement_hw": { "type": "string", "maxLength": 256 },
    "category": { "type": "string", "maxLength": 128 },
    "media": { "type": "string", "maxLength": 64 },
    "description": { "type": "string", "maxLength": 32768 },
    "crc32": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "origin_crc32": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "dump_status": {
      "enum": ["unknown", "good", "bad", "overdump", "hack", "translation", "homebrew"]
    },
    "cover": {
      "type": "object",
      "properties": {
        "mime_type": { "type": "string", "const": "image/png" },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
